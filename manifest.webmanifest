---
layout: null
permalink: /manifest.webmanifest
---
{
  "name": "{{ site.title }}",
  "short_name": "Agenda Tunis",
  "description": "{{ site.description }}",
  "lang": "fr",
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "standalone",
  "background_color": "#faf7f2",
  "theme_color": "#b5442f",
  "icons": [
    { "src": "{{ '/assets/icones/icone-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "{{ '/assets/icones/icone-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
